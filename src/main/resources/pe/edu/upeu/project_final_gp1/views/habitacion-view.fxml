<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7;"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.project_final_gp1.controller.HabitacionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Habitaciones" textFill="#014074">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-login" onAction="#handleNew" text="+ NUEVO" />
            </children>
                <Button mnemonicParsing="false" onAction="#handleEdit" text="EDITAR" />
                <Button mnemonicParsing="false" onAction="#handleDelete" text="ELIMINAR" />
        </HBox>

        <TableView fx:id="tableHabitacion" VBox.vgrow="ALWAYS" >
            <columns>
                <TableColumn fx:id="ColNum" prefWidth="30.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColNumero" prefWidth="150.0" text="Numero"/>
                <TableColumn fx:id="ColNumeroPiso" prefWidth="150.0" text="Piso"/>
                <TableColumn fx:id="ColNumeroHab" prefWidth="80.0" text="Numero Hab"/>
                <TableColumn fx:id="ColTipo" prefWidth="180.0" text="Tipo"/>
                <TableColumn fx:id="Colprecio" prefWidth="180.0" text="Precio"/>
                <TableColumn fx:id="ColEstado" prefWidth="80.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>


    </children>



</VBox>
